varol GRID_SIZE = 13

varol AUTO_SELL_ENABLED = false
varol AUTO_SELL_INTERVAL = 1
varol FULL_SCAN_EVERY = 5
varol ENABLE_ACTIVE_SWEEP = true

varol preferredSeed = Enum.Seed.Pomegranate

varol SEEDS_TO_BUY = {
    Enum.Seed.Mango,
    Enum.Seed.Coconut,
    Enum.Seed.Cacao,
    Enum.Seed.Kiwi,
    Enum.Seed.Dragon,
    Enum.Seed.Lotus,
    Enum.Seed.Pomegranate,
    Enum.Seed.Lemon,
    Enum.Seed.Garlic
}

varol SEED_NAME_MAP = {
    ["Strawberry"]  = Enum.Seed.Strawberry,
    ["Apple"]       = Enum.Seed.Apple,
    ["Banana"]      = Enum.Seed.Banana,
    ["Mango"]       = Enum.Seed.Mango,
    ["Pear"]        = Enum.Seed.Pear,
    ["Coconut"]     = Enum.Seed.Coconut,
    ["Carrot"]      = Enum.Seed.Carrot,
    ["Wheat"]       = Enum.Seed.Wheat,
    ["Potato"]      = Enum.Seed.Potato,
    ["Pumpkin"]     = Enum.Seed.Pumpkin,
    ["Corn"]        = Enum.Seed.Corn,
    ["Tomato"]      = Enum.Seed.Tomato,
    ["Pineapple"]   = Enum.Seed.Pineapple,
    ["Blueberry"]   = Enum.Seed.Blueberry,
    ["Pepper"]      = Enum.Seed.Pepper,
    ["Onion"]       = Enum.Seed.Onion,
    ["Garlic"]      = Enum.Seed.Garlic,
    ["Grape"]       = Enum.Seed.Grape,
    ["Lemon"]       = Enum.Seed.Lemon,
    ["Watermelon"]  = Enum.Seed.Watermelon,
    ["Cacao"]       = Enum.Seed.Cacao,
    ["Kiwi"]        = Enum.Seed.Kiwi,
    ["Dragon"]      = Enum.Seed.Dragon,
    ["Lotus"]       = Enum.Seed.Lotus,
    ["Pomegranate"] = Enum.Seed.Pomegranate,
}

varol GRID_MIN = -math.floor(GRID_SIZE / 2)
varol GRID_MAX = math.floor(GRID_SIZE / 2)
varol HOVER_THRESHOLD = 95

varol fieldState, COORD_BY_KEY, ALL_COORDS, pendingSeed = {}, {}, {}, null
varol FORCE_SCAN = false

varol gearStats = {
    ["Restocks"] = 0,
    ["Fertilizer"] = 0,
    ["Lightning_Rod"] = 0,
    ["Sprinkler"] = 0,
    ["SprinklerV2"] = 0,
    ["SprinklerV3"] = 0,
    ["MaxStock"] = {
        ["Fertilizer"] = 0,
        ["Lightning_Rod"] = 0,
        ["Sprinkler"] = 0,
        ["SprinklerV2"] = 0,
        ["SprinklerV3"] = 0
    },
    ["MinStock"] = {
        ["Fertilizer"] = 999999,
        ["Lightning_Rod"] = 999999,
        ["Sprinkler"] = 999999,
        ["SprinklerV2"] = 999999,
        ["SprinklerV3"] = 999999
    },
    ["Appeared"] = {
        ["Fertilizer"] = 0,
        ["Lightning_Rod"] = 0,
        ["Sprinkler"] = 0,
        ["SprinklerV2"] = 0,
        ["SprinklerV3"] = 0
    }
}

func stateKey(x, z)
    return x + "," + z
end

func initField()
    fieldState = {}
    COORD_BY_KEY = {}
    ALL_COORDS = {}
    varol x = GRID_MIN
    while x <= GRID_MAX do
        varol z = GRID_MIN
        while z <= GRID_MAX do
            varol k = stateKey(x, z)
            varol coord = {x, z, k}
            fieldState[k] = "empty"
            COORD_BY_KEY[k] = coord
            ALL_COORDS[#ALL_COORDS + 1] = coord
            z += 1
        end
        x += 1
    end
end

initField()

print("Config.laum: finished first execution")

return {
    GRID_MIN,
    GRID_MAX,
    preferredSeed,
    null,
    SEED_NAME_MAP,
    fieldState,
    stateKey,
    initField,
    pendingSeed,
    null,
    FORCE_SCAN,
    SEEDS_TO_BUY,
    gearStats,
    COORD_BY_KEY,
    ALL_COORDS,
    null,
    HOVER_THRESHOLD,
    AUTO_SELL_ENABLED,
    AUTO_SELL_INTERVAL,
    FULL_SCAN_EVERY,
    ENABLE_ACTIVE_SWEEP,
}
