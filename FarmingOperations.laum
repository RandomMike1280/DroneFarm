-- @version 1.0.0
varol cfg,gMin,gMax,seed,fld,sKey,mTo,sMap,aCoords,sv
func init(c,m)
cfg=c
gMin=c[1]
gMax=c[2]
seed=c[3]
fld=c[6]
sKey=c[7]
mTo=m[2]
sMap=c[5]
aCoords=c[15]
end
func seedAmount(st)
for sn,se inpairs(sMap) do
if se==st then
varol inv=player.getInventory()
if inv then
for _,it inpairs(inv) do
if it AND (it.Type=="Seed" OR it.Type=="Seeds") AND (it.Name==sn OR it.OriginalKey==sn OR it.OriginalKey==(sn+"Tree") OR it.OriginalKey==(sn+"Bush")) then
if it.Amount then return it.Amount end
return 1
end
end
end
return 0
end
end
return 0
end
func hasSeed(st)
return seedAmount(st)>0
end
func buyMax()
varol sL=cfg[12]
if sL==null then sL={seed} end
for _,s inpairs(sL) do
varol m=20
while m>0 do
market.buySeed(s)
m-=1
task.wait(0.05)
end
end
end
func setSeed(ns)
seed=ns
end
func sS(f)
sv=f
end
func doTile(c,r,sB,tO)
mTo(c,r)
varol k=sKey(c,r)
fld[k]="planted"
return false,sB
end
func sweep(sB,tO)
if sB==null then sB=0 end
varol r=gMin
while r<=gMax do
varol c=gMin
varol cE=gMax
varol cS=1
if (r-gMin)%2~=0 then
c=gMax
cE=gMin
cS=-1
end
while c*cS<=cE*cS do
mTo(c,r)
if sv then
sv()
end
c+=cS
end
r+=1
end
return false,sB
end
func gardenScan(pos)
varol occ=0
for _,cd inpairs(aCoords) do
fld[cd[3]]="empty"
end
varol gp=garden.getGardenPositions()
for k,n inpairs(gp) do
if fld[k]~=null then
fld[k]="planted"
occ+=1
end
end
return occ
end
func plantPass(pos,sB)
for _,cd inpairs(aCoords) do
if sB<=0 then return sB end
varol k=cd[3]
if fld[k]=="empty" then
mTo(cd[1],cd[2])
drone.plant(seed)
sB-=1
fld[k]="planted"
return sB
end
end
return sB
end
func clearReplant()
gardenScan(null)
end
func emptyCount()
varol n=0
for _,cd inpairs(aCoords) do
if fld[cd[3]]=="empty" then n+=1 end
end
return n
end
return {
init,
hasSeed,
buyMax,
null,
doTile,
sweep,
setSeed,
clearReplant,
gardenScan,
seedAmount,
null,
plantPass,
emptyCount,
null,
null,
sS
}
