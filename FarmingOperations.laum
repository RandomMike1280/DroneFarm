varol cfg,gMin,gMax,seed,fld,sKey,mTo,sMap,aCoords,route
func buildRoute()
route={}
varol r=gMin
while r<=gMax do
varol c,cE,cS=gMin,gMax,1
if (r-gMin)%2~=0 then
c=gMax
cE=gMin
cS=-1
end
while c*cS<=cE*cS do
route[#route+1]={c,r}
c+=cS
end
r+=1
end
end
func init(c,m)
cfg=c
gMin=c[1]
gMax=c[2]
seed=c[3]
fld=c[6]
sKey=c[7]
mTo=m[2]
sMap=c[5]
aCoords=c[15]
buildRoute()
end
func seedAmount(st)
for sn,se inpairs(sMap) do
if se==st then
for _,it inpairs(player.getInventory()) do
if it AND (it.Type=="Seed" OR it.Type=="Seeds") AND (it.Name==sn OR it.OriginalKey==sn OR it.OriginalKey==(sn+"Tree") OR it.OriginalKey==(sn+"Bush")) then
if it.Amount then return it.Amount end
return 1
end
end
return 0
end
end
return 0
end
func hasSeed(st)
return seedAmount(st)>0
end
func buyMax()
varol sL=cfg[12]
if sL==null then sL={seed} end
for _,s inpairs(sL) do
varol m=20
while m>0 do
market.buySeed(s)
m-=1
task.wait(0.05)
end
end
end
func doTile(c,r,sB,tO)
mTo(c,r)
varol k=sKey(c,r)
fld[k]="planted"
return false,sB
end
func sweep(sB,tO)
if sB==null then sB=0 end
for _,cd inpairs(route) do
mTo(cd[1],cd[2])
end
return false,sB
end
func gardenScan(pos)
varol occ=0
for _,cd inpairs(aCoords) do
fld[cd[3]]="empty"
end
for k,n inpairs(garden.getGardenPositions()) do
if fld[k]~=null then
fld[k]="planted"
occ+=1
end
end
return occ
end
func plantPass(pos,sB)
for _,cd inpairs(aCoords) do
if sB<=0 then return sB end
if fld[cd[3]]=="empty" then
mTo(cd[1],cd[2])
drone.plant(seed)
sB-=1
fld[cd[3]]="planted"
return sB
end
end
return sB
end
func clearReplant()
gardenScan(null)
end
func emptyCount()
varol n=0
for _,cd inpairs(aCoords) do
if fld[cd[3]]=="empty" then n+=1 end
end
return n
end
return {
init,
hasSeed,
buyMax,
null,
doTile,
sweep,
null,
clearReplant,
gardenScan,
seedAmount,
null,
plantPass,
emptyCount,
null,
null
}
