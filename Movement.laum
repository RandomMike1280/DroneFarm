varol lx,lz = null,null

func init(cfgRef)
end

func moveTo(tx, tz)
    while drone.status() ~= Enum.DroneStatus.Sleep do task.wait(0.03) end
    if drone.getPositionX() == tx AND drone.getPositionZ() == tz then return end
    droneV2.goto(tx, tz)
    while drone.status() ~= Enum.DroneStatus.Sleep do task.wait(0.03) end
end

return {
    init    = init,
    moveTo  = moveTo,
}
