-- ============================================================
-- MOVEMENT
-- Grid-relative movement helpers.
-- moveTo(tx, tz) moves the drone to absolute field coordinates.
-- ============================================================

-- [H2] Instrumentation: detect if this file is auto-executed
print("Movement.laum executing")

varol cfg = null
varol lx,lz = null,null

func init(cfgRef)
    cfg = cfgRef
end

func moveTo(tx, tz)
    while drone.status() ~= Enum.DroneStatus.Sleep do task.wait(0.03) end
    if lx == tx AND lz == tz then
        return
    end
    droneV2.goto(tx, tz)
    while drone.status() ~= Enum.DroneStatus.Sleep do task.wait(0.03) end
    lx=tx
    lz=tz
end

return {
    init    = init,
    moveTo  = moveTo,
}
