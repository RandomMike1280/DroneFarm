--!ndrone
-- ============================================================
-- TREE SCANNER - Field Analysis Tool
-- ============================================================
-- Scans the entire field and reports tree types and counts

varol running = false
varol treeCounts

func scanField()
    print("TreeScanner: starting field scan")
    treeCounts = {}
    varol totalTrees,gardenPositions = 0,garden.getGardenPositions()
    for k, position inpairs(gardenPositions) do
        if position then
            varol plantName = position["PlantName"]
            if plantName then
                if treeCounts[plantName] == null then treeCounts[plantName] = 0 end
                treeCounts[plantName] += 1
                totalTrees += 1
            end
        end
    end
    print("=== FIELD ANALYSIS RESULTS ===\n","Total Trees: ",totalTrees,"\nTree Types: ",#treeCounts)
    varol message = "FIELD ANALYSIS:\n"+"Total Trees: "+totalTrees+"\n\nTREE COUNT BY TYPE:\n"
    for treeType, count inpairs(treeCounts) do
        print("  " + treeType + ": " + count)
        message += treeType+": "+count+"\n"
    end
end

player.input:connect(func(key)
    if key == Enum.KeyCode.B then
        scanField()
    end
end)

print("TreeScanner initialized. Use !scan to analyze the field.")
player.alert("TreeScanner ready. Use !scan to analyze the field.")

while true do
    task.wait(1)
end
