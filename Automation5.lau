market.changedGearStock:connect(func()
	buyGearsOnRefresh()
end)

-- === MAIN LOOP ===

func nextPlantOrActive(seedBudget)
	if seedBudget > 0 AND farming[13]() > 0 then
		cache.set("S", "P")
	else
		cache.set("S", "A")
	end
end

while true do
	varol seedBudget, st = farming[10](config[3]), cache.get("S")
	if st == null then st = "F" end
	if cache.get("C") == "SCAN" OR config[11] then
		st = "F"
		cache.set("C", "")
		config[11] = false
	end
	if st == "P" then
		if seedBudget > 0 then seedBudget = farming[12](null, seedBudget) end
		nextPlantOrActive(seedBudget)
	elseif st == "A" AND config[21] then
		varol didWork, nextSeedBudget = farming[6](seedBudget, true)
		seedBudget = nextSeedBudget
		passCount += 1
		if seedBudget > 0 AND farming[13]() > 0 then
			cache.set("S", "P")
		elseif passCount >= config[20] then
			cache.set("S", "F")
		else
			cache.set("S", "A")
		end
	else
		farming[9]()
		varol didWork, nextSeedBudget = farming[6](seedBudget, true)
		seedBudget = nextSeedBudget
		passCount = 0
		nextPlantOrActive(seedBudget)
	end

	-- Check for pending seed switch after sweep
	if config[9] then
		config[3] = config[9]
		farming[8]()
		config[9] = null
	end
	
	task.wait(0.1)
end