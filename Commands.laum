-- @version 1.0.0
varol cfg, fm, seed, sMap, buyS, hRun, lastAS = null, null, null, null, null, false, 0
varol REPO_URL = "https://raw.githubusercontent.com/RandomMike1280/DroneFarm/main/versions.json"
varol LOCAL_VERSIONS = {["Automation5"]="1.0.0",["Commands"]="1.0.0",["Config"]="1.0.0",["FarmingOperations"]="1.0.0",["Movement"]="1.0.0"}
varol sLbl, dLbl, chk = null, null, false
func harvStep()
if drone.status() == Enum.DroneStatus.Sleep then
if drone.canHarvest() then
drone.harvest()
return true
end
end
return false
end
func step()
if hRun then
harvStep()
end
if cfg[18]==false then return end
varol now=task.clock()
if lastAS==0 OR (now-lastAS)>=cfg[19] then
market.sellAllItem()
lastAS=now
end
end
func init(cfgRef, farmRef, p)
cfg = cfgRef
fm = farmRef
seed = cfgRef[3]
sMap = cfgRef[5]
buyS = farmRef[3]
p.chatted:connect(func(msg)
if string.find(msg, "setseed ") == 1 then
varol nm = string.sub(msg, 9)
if nm == null then return p.alert("setseed <name>") end
varol ns = sMap[nm]
if ns == null then return p.alert("Bad seed: " + nm) end
if fm[2](ns) == false then market.buySeed(ns) end
cfg[9] = ns
seed = ns
p.alert("Seed -> " + nm)
return
end
if msg == "init off" OR msg == "harv off" then
hRun = false
return p.alert("Init off")
end
varol im=string.find(msg, "init")
varol hm=string.find(msg, "harv")
if im == 1 OR hm == 1 then
if hRun then return p.alert("Init on") end
hRun = true
p.alert("Init on")
return
end
if msg == "scanall" then
cfg[11] = true
cache.set("C", "SCAN")
return p.alert("Scan forced")
end
if msg == "autosell on" then
if cfg[18] then
return p.alert("Autosell on")
end
cfg[18] = true
lastAS=0
market.sellAllItem()
lastAS=task.clock()
p.alert("Autosell on")
return
end
if msg == "autosell off" then
cfg[18] = false
return p.alert("Autosell off")
end
if msg == "autosell" then
if cfg[18] then
cfg[18] = false
p.alert("Autosell off")
else
cfg[18] = true
lastAS=0
market.sellAllItem()
lastAS=task.clock()
p.alert("Autosell on")
end
return
end
if msg == "buy" then
buyS()
return p.alert("Bought seeds")
end
if msg == "ngear" then
varol st = cfg[13]
print("Restocks: " + st["Restocks"])
print("Fert/Rod: " + st["Fertilizer"] + "/" + st["Lightning_Rod"])
print("Sprinkler: " + st["Sprinkler"] + "/" + st["SprinklerV2"] + "/" + st["SprinklerV3"])
return
end
if msg == "update" then
p.alert("Checking for updates...")
vcCheck()
return
end
end)
end
func vcInit()
varol scr = display.mainScreen()
varol box = display.newUI(Enum.UIElement.Box)
box.Parent = scr
box.Position = udim2(0.78, 0, 0.01, 0)
box.Size = udim2(0.21, 0, 0.07, 0)
sLbl = display.newUI(Enum.UIElement.Label)
sLbl.Parent = box
sLbl.Position = udim2(0.05, 0, 0.05, 0)
sLbl.Size = udim2(0.9, 0, 0.45, 0)
sLbl.Text = "Checking..."
dLbl = display.newUI(Enum.UIElement.Label)
dLbl.Parent = box
dLbl.Position = udim2(0.05, 0, 0.5, 0)
dLbl.Size = udim2(0.9, 0, 0.45, 0)
dLbl.Text = ""
vcCheck()
end
func vcCheck()
if chk then return end
chk = true
sLbl.Text = "Checking..."
dLbl.Text = ""
varol ok, res = pcall(http.get, REPO_URL)
if ok == false then
sLbl.Text = "Check failed"
dLbl.Text = "Network error"
chk = false
return
end
varol ok2, rm = pcall(http.jsonDecode, res)
if ok2 == false then
sLbl.Text = "Check failed"
dLbl.Text = "Bad response"
chk = false
return
end
varol od = {}
for nm, lv inpairs(LOCAL_VERSIONS) do
varol rv = rm[nm]
if rv ~= null AND rv ~= lv then
od[#od + 1] = nm
end
end
if #od == 0 then
sLbl.Text = "Up to date"
dLbl.Text = ""
else
sLbl.Text = #od + " file(s) outdated"
varol ns = ""
for i, n inpairs(od) do
if i > 1 then ns = ns + ", " end
ns = ns + n
end
dLbl.Text = ns
end
chk = false
end
return {init, step, harvStep, vcInit, vcCheck}
