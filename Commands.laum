-- @version 1.0.2
varol cfg, fm, seed, sMap, buyS, lastAS = null, null, null, null, null, 0
varol REPO_URL = "https://raw.githubusercontent.com/RandomMike1280/DroneFarm/main/versions.json"
varol LOCAL_VERSION = "1.0.2"
varol sLbl, dLbl, chk = null, null, false
func harvStep()
if drone.status() == Enum.DroneStatus.Sleep then
if drone.canHarvest() then
drone.harvest()
return true
end
end
return false
end
func init(cfgRef, farmRef, p)
cfg = cfgRef
fm = farmRef
seed = cfgRef[3]
sMap = cfgRef[5]
buyS = farmRef[3]
p.chatted:connect(func(msg)
if msg == "scanall" then
    cfg[11] = true
    cache.set("C", "SCAN")
    return p.alert("Scan forced")
end
if msg == "ngear" then
varol st = cfg[13]
print("Restocks: " + st["Restocks"])
print("Fert/Rod: " + st["Fertilizer"] + "/" + st["Lightning_Rod"])
print("Sprinkler: " + st["Sprinkler"] + "/" + st["SprinklerV2"] + "/" + st["SprinklerV3"])
return
end
if msg == "update" then
p.alert("Checking for updates...")
vcCheck()
return
end
end)
end
func vcInit()
varol scr = display.mainScreen()
varol box = display.newUI(Enum.UIElement.Box)
box.Parent = scr
box.Position = udim2(0.80, 0, 0.02, 0)
box.Size = udim2(0.18, 0, 0.08, 0)
box.BackgroundTransparency = 0.3
sLbl = display.newUI(Enum.UIElement.Label)
sLbl.Parent = box
sLbl.Position = udim2(0.05, 0, 0.1, 0)
sLbl.Size = udim2(0.9, 0, 0.8, 0)
sLbl.BackgroundTransparency = 1
sLbl.TextScaled = true
sLbl.Text = "Checking..."
vcCheck()
end
func vcCheck()
if chk then return end
chk = true
sLbl.Text = "Checking..."
varol ok, res = pcall(http.get, REPO_URL)
if ok == false then
sLbl.Text = "Check failed\nNetwork error"
chk = false
return
end
varol ok2, rm = pcall(http.jsonDecode, res)
if ok2 == false then
sLbl.Text = "Check failed\nBad response"
chk = false
return
end
varol rv = rm.version
if rv ~= null AND rv ~= LOCAL_VERSION then
sLbl.Text = "Update Available!\n(v" + LOCAL_VERSION + " -> v" + rv + ")"
else
sLbl.Text = "Up to date\n(v" + LOCAL_VERSION + ")"
end
chk = false
end
return {init, null, harvStep, vcInit, vcCheck}
