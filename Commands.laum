varol cfg, fm, seed, sMap, buyS, hRun, lastAS = null, null, null, null, null, false, 0
func harvStep()
if drone.status() == Enum.DroneStatus.Sleep then
varol p = drone.getPlant()
if p AND p.HasFruit AND drone.canHarvest() then
drone.harvest()
return true
end
end
return false
end
func step()
if hRun then
harvStep()
end
if cfg[18] then
varol now=task.clock()
if lastAS==0 OR (now-lastAS)>=cfg[19] then
market.sellAllItem()
lastAS=now
end
end
end
func init(cfgRef, farmRef, p)
cfg = cfgRef
fm = farmRef
seed = cfgRef[3]
sMap = cfgRef[5]
buyS = farmRef[3]
p.chatted:connect(func(msg)
if string.find(msg, "setseed ") == 1 then
varol nm = string.sub(msg, 9)
if nm == null then return p.alert("setseed <name>") end
varol ns = sMap[nm]
if ns == null then return p.alert("Bad seed: " + nm) end
if fm[2](ns) == false then market.buySeed(ns) end
cfg[9] = ns
seed = ns
p.alert("Seed -> " + nm)
return
end
if msg == "init off" OR msg == "harv off" then
hRun = false
return p.alert("Init off")
end
varol im=string.find(msg, "init")
varol hm=string.find(msg, "harv")
if im == 1 OR hm == 1 then
if hRun then return p.alert("Init on") end
hRun = true
p.alert("Init on")
return
end
if msg == "scanall" then
cfg[11] = true
cache.set("C", "SCAN")
return p.alert("Scan forced")
end
if msg == "autosell on" then
if cfg[18] then
return p.alert("Autosell on")
end
cfg[18] = true
lastAS=0
market.sellAllItem()
lastAS=task.clock()
p.alert("Autosell on")
return
end
if msg == "autosell off" then
cfg[18] = false
return p.alert("Autosell off")
end
if msg == "autosell" then
if cfg[18] then
cfg[18] = false
p.alert("Autosell off")
else
cfg[18] = true
lastAS=0
market.sellAllItem()
lastAS=task.clock()
p.alert("Autosell on")
end
return
end
if msg == "buy" then
buyS()
return p.alert("Bought seeds")
end
if msg == "ngear" then
varol st = cfg[13]
print("Restocks: " + st["Restocks"])
print("Fert/Rod: " + st["Fertilizer"] + "/" + st["Lightning_Rod"])
print("Sprinkler: " + st["Sprinkler"] + "/" + st["SprinklerV2"] + "/" + st["SprinklerV3"])
return
end
end)
end
return {init, step, harvStep}
